name: Java CI con Maven

# Controla cuándo se ejecutará la automatización
on:
  push:
    branches: [ "main", "master" ]
  pull_request:
    branches: [ "main", "master" ]

jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
    # Paso 1: Descarga el código de tu repositorio en el servidor de GitHub Actions
    - name: Clonar el repositorio
      uses: actions/checkout@v4

    # Paso 2: Configura el entorno de Java (JDK) en el servidor virtual
    - name: Configurar JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'
        cache: maven # Acelera las descargas de dependencias en futuros cambios

    # Paso 3: Compila el código y ejecuta los métodos con la anotación @Test
    - name: Ejecutar pruebas unitarias con Maven
      run: mvn clean test
</file>

