-- Vista de sesiones activas (no expiradas, no revocadas)
CREATE   VIEW [dbo].[vw_SesionesActivas] AS
SELECT
    s.SesionID,
    s.UsuarioID,
    u.NombreUsuario,
    u.CorreoElectronico,
    s.IPAddress,
    s.FechaCreacion,
    s.FechaExpiracion
FROM dbo.Sesiones s
INNER JOIN dbo.Usuarios u ON s.UsuarioID = u.UsuarioID
WHERE s.Revocada = 0
  AND s.FechaExpiracion > GETDATE();
